# Discord
DISCORD_TOKEN=
# Optional. Set it during development to sync slash commands to one server instantly.
DISCORD_GUILD_ID=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=
# Optional personal access token, used for read-only calls when the app has no installation.
GITHUB_TOKEN=

# Webhook server. On Pterodactyl, leave WEBHOOK_PORT empty and SERVER_PORT is used.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=

# Bot settings
ADMIN_ROLE_NAME=Admin
SUPPORT_EMAIL=support@saiyiidev.com
# Announce pushes on every branch instead of only the default one.
PUSH_ALL_BRANCHES=false
DATABASE_PATH=./gitpulse.db
LOG_LEVEL=INFO
